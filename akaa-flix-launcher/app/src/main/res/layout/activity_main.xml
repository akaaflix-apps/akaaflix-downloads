<?xml version="1.0" encoding="utf-8"?>
<com.akaaflix.launcher.remote.NavigationRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.akaaflix.launcher.wallpaper.view.WallpaperHostView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/pageScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/page_scrim"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/headerArt"
            android:layout_width="290dp"
            android:layout_height="101dp"
            android:layout_gravity="top|left"
            android:layout_marginLeft="108dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/header_pyramid" />

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <com.akaaflix.launcher.home.shell.TopBarView
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:layout_gravity="top" />

        <com.akaaflix.launcher.home.shell.SidebarView
            android:id="@+id/sidebar"
            android:layout_width="@dimen/sidebar_width"
            android:layout_height="match_parent"
            android:layout_gravity="left|top"
            android:layout_marginTop="@dimen/sidebar_top"
            android:layout_marginBottom="@dimen/sidebar_bottom" />
    </FrameLayout>
</com.akaaflix.launcher.remote.NavigationRootLayout>
