<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.core.widget.NestedScrollView android:id="@+id/mainScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:fillViewport="true"
    android:paddingTop="@dimen/page_top"
    android:clipToPadding="true">
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingLeft="@dimen/content_start"
        android:paddingTop="4dp"
        android:paddingRight="@dimen/content_end"
        android:paddingBottom="@dimen/bottom_nav_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <GridLayout
                android:id="@+id/tiles"
                android:layout_width="match_parent"
                android:layout_height="560dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="2"
                android:rowCount="6" />

            <LinearLayout
                android:id="@+id/infoRow"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:orientation="vertical">
            <LinearLayout android:id="@+id/storageCard" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginBottom="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                <ImageView android:id="@+id/storageCardIcon" android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no" android:src="@drawable/ic_storage" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/set_storage" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" android:textDirection="locale" />
                    <TextView android:id="@+id/storageCardValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Caption" android:textColor="@color/text_primary" />
                    <com.akaaflix.launcher.core.ui.NeonProgressBar android:id="@+id/storageCardProgress" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/ramCard" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginBottom="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                <ImageView android:id="@+id/ramCardIcon" android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no" android:src="@drawable/ic_memory" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/set_ram" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" android:textDirection="locale" />
                    <TextView android:id="@+id/ramCardValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Caption" android:textColor="@color/text_primary" />
                    <com.akaaflix.launcher.core.ui.NeonProgressBar android:id="@+id/ramCardProgress" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/deviceCard" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginBottom="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                <ImageView android:id="@+id/deviceCardIcon" android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no" android:src="@drawable/ic_cpu" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/set_device_info" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" android:textDirection="locale" />
                    <TextView android:id="@+id/deviceCardValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Caption" android:textColor="@color/text_primary" />
                    <com.akaaflix.launcher.core.ui.NeonProgressBar android:id="@+id/deviceCardProgress" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rightPanel"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:importantForAccessibility="no" android:src="@drawable/ic_logo_mark" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/brand_line1" android:textAppearance="@style/TextAppearance.Akaa.Section" android:textSize="18sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/brand_line2" android:textAppearance="@style/TextAppearance.Akaa.Label" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/versionPill" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" android:textSize="12sp" />
                <ImageView android:id="@+id/versionCheck" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:padding="3dp" android:src="@drawable/ic_check" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickToggles"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="vertical"
                android:padding="4dp">
                <LinearLayout android:id="@+id/qtAutostart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView style="@style/Akaa.AutoLabel" android:layout_width="0dp" android:layout_height="20dp" android:layout_weight="1" android:text="@string/set_quick_autostart" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Label" android:textSize="12sp" />
                    <com.akaaflix.launcher.core.ui.NeonSwitch android:id="@+id/qtAutostartSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/qtNetwork" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView style="@style/Akaa.AutoLabel" android:layout_width="0dp" android:layout_height="20dp" android:layout_weight="1" android:text="@string/set_quick_network" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Label" android:textSize="12sp" />
                    <com.akaaflix.launcher.core.ui.NeonSwitch android:id="@+id/qtNetworkSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/qtClock" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView style="@style/Akaa.AutoLabel" android:layout_width="0dp" android:layout_height="20dp" android:layout_weight="1" android:text="@string/set_quick_clock" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Label" android:textSize="12sp" />
                    <com.akaaflix.launcher.core.ui.NeonSwitch android:id="@+id/qtClockSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/qtMotion" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView style="@style/Akaa.AutoLabel" android:layout_width="0dp" android:layout_height="20dp" android:layout_weight="1" android:text="@string/set_quick_motion" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Label" android:textSize="12sp" />
                    <com.akaaflix.launcher.core.ui.NeonSwitch android:id="@+id/qtMotionSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/qtAnimated" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <TextView style="@style/Akaa.AutoLabel" android:layout_width="0dp" android:layout_height="20dp" android:layout_weight="1" android:text="@string/set_quick_animated_bg" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Label" android:textSize="12sp" />
                    <com.akaaflix.launcher.core.ui.NeonSwitch android:id="@+id/qtAnimatedSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/checkUpdates" style="@style/Akaa.Chip" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="8dp" android:drawableEnd="@drawable/ic_refresh" android:text="@string/set_check_updates" android:textSize="12sp" />
            <TextView android:id="@+id/restoreDefaults" style="@style/Akaa.Chip" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="6dp" android:drawableEnd="@drawable/ic_restore" android:text="@string/set_restore_defaults" android:textSize="11sp" />
            <TextView android:id="@+id/applyChanges" style="@style/Akaa.Chip" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:drawableEnd="@drawable/ic_check" android:text="@string/set_apply_changes" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/detailContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="@dimen/content_start"
        android:paddingTop="@dimen/page_top"
        android:paddingRight="@dimen/content_end"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/detailBack" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@string/back" android:focusable="true" android:padding="10dp" android:src="@drawable/ic_back" />
            <ImageView android:id="@+id/detailIcon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="14dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/detailTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Section" android:textSize="19sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detailList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="12dp" />
    </LinearLayout>
</FrameLayout>
