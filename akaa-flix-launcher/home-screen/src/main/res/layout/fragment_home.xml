<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Height is computed at runtime: exactly [homeRows] (3 by default) rows that fit between the
         logo/date header and the bottom controls on 720p, 1080p and 4K screens. -->
    <FrameLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginLeft="112dp"
        android:layout_marginTop="@dimen/home_grid_top"
        android:layout_marginRight="10dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.akaaflix.launcher.remote.PagedGridRecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="ltr" />

        <TextView
            android:id="@+id/homeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textAppearance="@style/TextAppearance.Akaa.Section"
            android:visibility="gone" />
    </FrameLayout>

    <ImageView
        android:id="@+id/remoteDecor"
        android:layout_width="@dimen/home_remote_decor_width"
        android:layout_height="@dimen/home_remote_decor_height"
        android:layout_gravity="bottom|right"
        android:contentDescription="@string/cd_remote_decor"
        android:scaleType="fitXY"
        android:src="@drawable/home_remote_decor" />

    <LinearLayout
        android:id="@+id/weatherWidget"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="14dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:layoutDirection="locale"
        android:minWidth="150dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="18dp"
        android:visibility="gone">
        <ImageView android:id="@+id/weatherIcon" android:layout_width="40dp" android:layout_height="40dp" android:importantForAccessibility="no" android:src="@drawable/ic_weather_partly_night" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                <TextView android:id="@+id/weatherTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/TextAppearance.Akaa.Section" android:textSize="21sp" />
                <TextView android:id="@+id/weatherCond" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:includeFontPadding="false" android:maxWidth="140dp" android:singleLine="true" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/weatherPlace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableEnd="@drawable/ic_location" android:drawablePadding="4dp" android:maxWidth="150dp" android:singleLine="true" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/weatherHiLo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:singleLine="true" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textColor="@color/text_primary" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="22dp"
        android:clipChildren="false"
        android:layoutDirection="ltr"
        android:orientation="horizontal">
        <ImageView android:id="@+id/searchBtn" style="@style/Akaa.HomeAction" android:contentDescription="@string/home_search" android:src="@drawable/ic_search" />
        <ImageView android:id="@+id/appsBtn" style="@style/Akaa.HomeAction" android:layout_marginStart="18dp" android:contentDescription="@string/home_apps" android:src="@drawable/ic_apps" />
        <ImageView android:id="@+id/infoBtn" style="@style/Akaa.HomeAction" android:layout_marginStart="18dp" android:contentDescription="@string/home_device_info" android:src="@drawable/ic_info" />
    </LinearLayout>

    <TextView
        android:id="@+id/moveHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:maxWidth="560dp"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="@string/move_mode_hint"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Akaa.Label"
        android:visibility="gone" />
</FrameLayout>
