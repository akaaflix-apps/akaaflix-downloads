<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Brand pill (avatar on home, logo mark elsewhere) -->
    <LinearLayout
        android:id="@+id/brandPill"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:contentDescription="@string/cd_profile"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="18dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/brandIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_logo_mark" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="-4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_crown" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/brandLine1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxWidth="120dp"
                android:singleLine="true"
                android:text="@string/brand_line1"
                android:textAppearance="@style/TextAppearance.Akaa.LabelBold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/brandLine2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/brand_line2"
                android:textAppearance="@style/TextAppearance.Akaa.Label"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Centre: big logo on home, icon + title + subtitle elsewhere -->
    <LinearLayout
        android:id="@+id/headerCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginLeft="250dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="300dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/titleRow"
            android:layoutDirection="locale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/titleIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#AA000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textAppearance="@style/TextAppearance.Akaa.Title" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxWidth="500dp"
            android:textSize="11sp"
            android:shadowColor="#AA000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Akaa.Subtitle"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/homeLogo"
        android:layout_width="282dp"
        android:layout_height="82dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="44dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/akaa_logo"
        android:visibility="gone" />

    <!-- Status: clock, Wi-Fi, settings + Gregorian/Hijri date pill -->
    <LinearLayout
        android:id="@+id/statusArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:clipChildren="false"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Akaa.Clock" />

            <TextView
                android:id="@+id/clockAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textAppearance="@style/TextAppearance.Akaa"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/wifiIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="30dp"
                android:contentDescription="@string/cd_wifi"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_wifi" />

            <ImageView
                android:id="@+id/gearButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/cd_open_settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/datePill"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:id="@+id/dateBlockA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView android:id="@+id/dateIconA" android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_calendar" />

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/dateA1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" android:textSize="11sp" />
                    <TextView android:id="@+id/dateA2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textColor="@color/text_primary" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <View android:id="@+id/dateDivider" android:layout_width="1dp" android:layout_height="26dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:background="#66FFFFFF" />

            <LinearLayout
                android:id="@+id/dateBlockB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView android:id="@+id/dateIconB" android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_moon" />

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/dateB1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" android:textSize="11sp" />
                    <TextView android:id="@+id/dateB2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textColor="@color/text_primary" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
