<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="@dimen/home_grid_top"
        android:layout_marginEnd="10dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.akaaflix.launcher.remote.PagedGridRecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="ltr" />

        <TextView android:id="@+id/homeMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:textAppearance="@style/TextAppearance.Akaa.Section" android:visibility="gone" />
    </FrameLayout>

    <ImageView android:id="@+id/remoteDecor" android:layout_width="0dp" android:layout_height="0dp" android:importantForAccessibility="no" android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="74dp"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/weatherWidget" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginBottom="8dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:layoutDirection="locale" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="16dp" android:visibility="gone">
            <ImageView android:id="@+id/weatherIcon" android:layout_width="40dp" android:layout_height="40dp" android:importantForAccessibility="no" android:src="@drawable/ic_weather_partly_night" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                    <TextView android:id="@+id/weatherTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/TextAppearance.Akaa.Section" android:textSize="21sp" />
                    <TextView android:id="@+id/weatherCond" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:includeFontPadding="false" android:maxWidth="130dp" android:singleLine="true" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textColor="@color/text_primary" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/weatherPlace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableEnd="@drawable/ic_location" android:drawablePadding="4dp" android:maxWidth="140dp" android:singleLine="true" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/weatherHiLo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:singleLine="true" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textColor="@color/text_primary" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/bottomBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clipChildren="false" android:layoutDirection="ltr" android:orientation="horizontal">
            <ImageView android:id="@+id/searchBtn" style="@style/Akaa.HomeAction" android:contentDescription="@string/home_search" android:src="@drawable/ic_search" />
            <ImageView android:id="@+id/appsBtn" style="@style/Akaa.HomeAction" android:layout_marginStart="18dp" android:contentDescription="@string/home_apps" android:src="@drawable/ic_apps" />
            <ImageView android:id="@+id/infoBtn" style="@style/Akaa.HomeAction" android:layout_marginStart="18dp" android:contentDescription="@string/home_device_info" android:src="@drawable/ic_info" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/moveHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:maxWidth="340dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/move_mode_hint"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Akaa.Label"
        android:visibility="gone" />
</FrameLayout>
