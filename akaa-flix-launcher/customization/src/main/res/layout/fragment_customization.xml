<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingLeft="@dimen/content_start"
    android:paddingTop="@dimen/page_top"
    android:paddingRight="@dimen/content_end"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/previewCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="0.47"
            android:padding="8dp">

            <com.akaaflix.launcher.home.ui.HomePreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <GridLayout
            android:id="@+id/tiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="0.53"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:columnCount="3"
            android:rowCount="2">
            <LinearLayout android:id="@+id/tileWallpapers" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/tileWallpapersIcon" android:layout_width="36dp" android:layout_height="36dp" android:importantForAccessibility="no" android:src="@drawable/ic_image" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="1" android:text="@string/cust_wallpapers" android:textAppearance="@style/TextAppearance.Akaa.Section" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tileLayout" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/tileLayoutIcon" android:layout_width="36dp" android:layout_height="36dp" android:importantForAccessibility="no" android:src="@drawable/ic_apps" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="1" android:text="@string/cust_layout" android:textAppearance="@style/TextAppearance.Akaa.Section" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tileColors" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/tileColorsIcon" android:layout_width="36dp" android:layout_height="36dp" android:importantForAccessibility="no" android:src="@drawable/ic_palette" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="1" android:text="@string/cust_colors" android:textAppearance="@style/TextAppearance.Akaa.Section" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tileApps" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/tileAppsIcon" android:layout_width="36dp" android:layout_height="36dp" android:importantForAccessibility="no" android:src="@drawable/ic_apps" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="1" android:text="@string/cust_apps" android:textAppearance="@style/TextAppearance.Akaa.Section" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tileCursor" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/tileCursorIcon" android:layout_width="36dp" android:layout_height="36dp" android:importantForAccessibility="no" android:src="@drawable/ic_cursor" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="1" android:text="@string/cust_cursor" android:textAppearance="@style/TextAppearance.Akaa.Section" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tileFonts" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/tileFontsIcon" android:layout_width="36dp" android:layout_height="36dp" android:importantForAccessibility="no" android:src="@drawable/ic_text_size" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="1" android:text="@string/cust_fonts" android:textAppearance="@style/TextAppearance.Akaa.Section" android:textSize="14sp" />
            </LinearLayout>
        </GridLayout>
    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layoutDirection="ltr"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/toggleMotion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:layoutDirection="locale"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/ic_sparkles" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Akaa.AutoLabel" android:layout_width="match_parent" android:layout_height="18dp" android:text="@string/cust_motion" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:lineSpacingMultiplier="0.9" android:text="@string/cust_motion_sub" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textSize="9sp" />
            </LinearLayout>

            <com.akaaflix.launcher.core.ui.NeonSwitch android:id="@+id/toggleMotionSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/toggleClock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:layoutDirection="locale"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/ic_clock" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Akaa.AutoLabel" android:layout_width="match_parent" android:layout_height="18dp" android:text="@string/cust_clock" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:lineSpacingMultiplier="0.9" android:text="@string/cust_clock_sub" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textSize="9sp" />
            </LinearLayout>

            <com.akaaflix.launcher.core.ui.NeonSwitch android:id="@+id/toggleClockSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/toggleFavBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:layoutDirection="locale"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/ic_apps" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Akaa.AutoLabel" android:layout_width="match_parent" android:layout_height="18dp" android:text="@string/cust_favbar" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:lineSpacingMultiplier="0.9" android:text="@string/cust_favbar_sub" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.Small" android:textSize="9sp" />
            </LinearLayout>

            <com.akaaflix.launcher.core.ui.NeonSwitch android:id="@+id/toggleFavBarSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/iconSizeCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:layoutDirection="locale"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView android:id="@+id/iconSizeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_apps" android:drawablePadding="6dp" android:gravity="center_vertical" android:maxLines="1" android:text="@string/row_icon_size" android:textAlignment="viewStart" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" />

            <LinearLayout android:id="@+id/iconSizes" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="4dp" android:clipChildren="false" android:gravity="center" android:layoutDirection="locale" android:orientation="horizontal">
                <TextView android:id="@+id/sizeMedium" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:maxLines="1" android:text="@string/size_medium" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" android:textSize="12sp" />
                <TextView android:id="@+id/sizeLarge" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:maxLines="1" android:text="@string/size_large" android:textAppearance="@style/TextAppearance.Akaa.LabelBold" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:clipChildren="false"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <TextView android:id="@+id/restoreButton" style="@style/Akaa.Chip" android:layout_width="210dp" android:layout_height="42dp" android:drawableEnd="@drawable/ic_restore" android:text="@string/cust_restore" />
        <TextView android:id="@+id/saveButton" style="@style/Akaa.Chip" android:layout_width="210dp" android:layout_height="42dp" android:layout_marginStart="24dp" android:drawableEnd="@drawable/ic_check" android:text="@string/cust_save" />
    </LinearLayout>
</LinearLayout>
