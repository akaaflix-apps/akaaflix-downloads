<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the app-options menu open the system uninstall dialog (Android 9+ requirement). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!--
      App manager: lists every installed package (including non-launchable pre-installed ones and
      packages removed for the current user) so they can be disabled / restored. Install-time
      permission; the list never leaves the device.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <!-- Package visibility (Android 11+): launchable phone and TV apps only. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.android.vending" />
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <!--
          Optional Home-button service (Settings → Accessibility → Services → Akaa Flix Launcher).
          Turned on only by the user; only Android (BIND_ACCESSIBILITY_SERVICE) can bind it.
        -->
        <service
            android:name="com.akaaflix.launcher.apps.home.HomeAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/akaa_home_accessibility" />
        </service>
    </application>
</manifest>
