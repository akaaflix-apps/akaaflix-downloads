// Release: Universal (Apple Silicon arm64 + Intel x86_64), optimised, hardened, notarization-ready.
#include "Base.xcconfig"

ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
GCC_OPTIMIZATION_LEVEL = s
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
SWIFT_ACTIVE_COMPILATION_CONDITIONS = RELEASE
ENABLE_TESTABILITY = NO
VALIDATE_PRODUCT = YES
STRIP_INSTALLED_PRODUCT = YES
COPY_PHASE_STRIP = NO

// Optional Developer ID signing (not committed). Copy Signing.example.xcconfig → Signing.xcconfig.
#include? "Signing.xcconfig"
