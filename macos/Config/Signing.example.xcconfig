// Copy to Config/Signing.xcconfig (git-ignored) to sign Release builds with your Developer ID.
// Without it, Release builds are ad-hoc signed (runs locally; not notarizable).

CODE_SIGN_IDENTITY = Developer ID Application
DEVELOPMENT_TEAM = ABCDE12345
OTHER_CODE_SIGN_FLAGS = --timestamp
// AKAAFLIX_SUPPORT_WHATSAPP = +201234567890
